if [ "$1" = "demo" ]; then
    TAGS="demo,web"
    shift
    FUZZER_PORT=20260 FUZZER_HOST=0.0.0.0 FUZZER_WEBPORT=8080 FUZZER_COMMIT_ID=$(git rev-parse HEAD) go test -tags="$TAGS" -v -run Test0 -timeout 105m "$@"
else
