        SIM_NAME="$1"
        shift
    fi
    FUZZER_PORT=20260 FUZZER_HOST=0.0.0.0 FUZZER_SIM_NAME="$SIM_NAME" FUZZER_WEBPORT=8080 FUZZER_COMMIT_ID=$(git rev-parse HEAD) go test -tags="$TAGS" -v -run TestSimFuzzer -timeout 105m -sim="$SIM_NAME" "$@"
fi
